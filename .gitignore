# Archive folder (legacy/dev-only files)
_archive/

# Python/build artifacts
.envs/
build/
__pycache__/
.pytest_cache/
*.pyc
*.egg-info/
.cache/
.engine-setup/
.model_cache/
.tools/
.venv/

# Third-party and examples
examples/
third_party/

# audio.cpp clone (build-time dependency, vendored by scripts/build_audio_cpp.sh)
audio.cpp/

# Temporary development folders
tmp_gui_repo/

# Qwen Code config
.qwen/

# Omega meta-skill convergence workspace (ledger, changelist, checklist, report)
.omega/

# Temporary credentials
gha-creds-*.json

# Freebuff client database
.freebuff/

# Runtime directories - contents ignored but directories kept for structure
# Input/ - user dialogue source files (keep .txt samples, ignore runtime)
Input/test/
Input/**/*.pkl
Input/**/*.json
Input/**/*.diff
Input/**/*.log
Input/**/*.flac
Input/**/*.wav
# Ad-hoc/debug dialogue files (curated samples stay tracked)
Input/inspect_*.txt
Input/visible_*.txt
Input/*_tmp*.txt
!Input/test/.gitkeep

# Output/ - rendered audio and cache (all runtime-generated)
Output/**/*.flac
Output/**/*.wav
Output/**/*.srt
Output/**/*.pkl
Output/**/*.json
Output/**/*.diff
Output/**/*.log
Output/**/*.png

# Profiles/ - voice profiles (runtime-generated)
Profiles/**/*.json
# Derived blend reference clips (regenerated deterministically from the catalog)
Profiles/.blends/

# Seashells/ - curated voice references (keep .wav, ignore cache)
Seashells/.oracle_preview/
Seashells/**/*.pkl

# logs/ - repo-local rotating application logs (runtime-generated)
logs/

# user_settings/ - GUI settings (runtime-generated)
user_settings/**/*.json

# release_artifacts/ - build outputs (generated by release script)
release_artifacts/**/*.tar.gz
release_artifacts/**/*.whl
release_artifacts/**/*.sha256
release_artifacts/**/*.json

# added by serpent-circle (chain workspace)
.serpent-circle/

# Crash unit runtime artifacts (CRASH_TELEMETRY_DESIGN §2/§3): local-only
# diagnostics; never tracked, never shipped.
crash_reports/
crash_consent.json

# User working files, keep-dispositioned in STATE.md (## Deferred):
# "do not clean, do not track" — ignored, never deleted, still on disk.
# render_plan.json.bak: user's render-plan backup (the Output/ runtime
# section's *.json rule cannot match the .json.bak suffix).
Output/**/*.bak
Seashells/Seashell_No_1.wav
JUNO_BRIEF.md
JUNO_FIRST_PROMPT.txt

# Recording Studio takes and the user's teleprompter script (2026-09-28):
# personal voice takes and a working prompt, not catalog voice references.
Seashells/Seashell_No_2.wav
Seashells/Seashell_ fransisco.wav
Seashells/seashell fransisco.wav
Seashells/seashell fransisco_TTS_clean_v5_aggressive_targeted_cleanup.wav
Input/recording prompt.txt
